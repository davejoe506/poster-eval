# Lightweight local Airflow: SequentialExecutor + SQLite + standalone (no Redis/Celery).
# Copy to .env and adjust as needed. docker-compose.yml also has matching defaults.
# These two are applied by scripts/airflow_entrypoint.py — `airflow standalone` ignores them.

AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

AIRFLOW__CORE__EXECUTOR=SequentialExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__DAGS_FOLDER=/opt/airflow/dags
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=true

POSTEREVAL_HOME=/opt/poster-eval
POSTEREVAL_DATA_DIR=/opt/poster-eval/data/processed
POSTEREVAL_DB_PATH=/opt/poster-eval/data/processed/postereval.db
POSTEREVAL_N_IMPRESSIONS=20000
POSTEREVAL_N_TITLES=200
POSTEREVAL_N_USERS=500
POSTEREVAL_SEED=42
POSTEREVAL_PROPENSITY_MODEL=xgboost
PYTHONPATH=/opt/poster-eval

# FastAPI (docker compose service `api`)
# http://localhost:8000/docs
